params {
    plasmids               = 'plasmids'      // directory holding one FASTA per plasmid
    min_block_size         = 5               // smallest group of genes that counts as a block
    min_presence           = 0.90            // gene must be in at least this fraction of plasmids
    no_bakta               = false           // --no_bakta skips Bakta gene names and its database download
    bakta_full             = false           // --bakta_full uses Bakta's full database instead of the light one
    tree                   = null            // --tree mytree.nwk uses that Newick tree instead of building one
    bakta_db               = null            // existing Bakta database; null downloads it
    bakta_cache            = "$projectDir/.plock-cache/bakta-1.12"
    simulations            = 1000000         // most tree simulations per gene pair; each stops once 10 reach the observed co-changes
    seed                   = 1               // seed for tree simulations and tree search
    k                      = 31              // ggCaller k-mer length
    cpus                   = 8               // cores given to each step
    memory                 = '16 GB'         // memory given to each step
    single_job             = true            // run one task at a time
    outdir                 = 'results'
}

// allow normal executor concurrency when single_job is disabled.
executor { queueSize = params.single_job.toString().toBoolean() ? 1 : 100 }
process {
    cpus   = { params.cpus }
    memory = { params.memory as nextflow.util.MemoryUnit }
}

docker.enabled = true
profiles {
    apple_silicon {
        docker.runOptions = '-e KMP_AFFINITY=disabled -e OMP_NUM_THREADS=1 -e MKL_NUM_THREADS=1 -e OPENBLAS_NUM_THREADS=1 -e PLOCK_DIAMOND_ARM64=1'
        process {
            withName: GGCALLER { cpus = 1 }
        }
    }
}
process {
    withName: 'PREPARE|GGCALLER|BAKTA_DB|BAKTA' { container = 'plock/annotation:0.1' }
    withName: PANAROO  { container = 'plock/panaroo:0.1' }
    withName: 'ALIGN|TREE' { container = 'plock/tree:0.1' }
    withName: BLOCKS   { container = 'plock/plock:0.1' }
}

process {
    withName: GGCALLER { publishDir = [path: "${params.outdir}/raw/ggcaller", mode: 'copy'] }
    withName: BAKTA { publishDir = [path: "${params.outdir}/raw/bakta", mode: 'copy'] }
    withName: PANAROO { publishDir = [path: "${params.outdir}/raw/panaroo", mode: 'copy'] }
    withName: ALIGN { publishDir = [path: "${params.outdir}/raw/alignments", mode: 'copy'] }
    withName: TREE { publishDir = [path: "${params.outdir}/raw/tree", mode: 'copy'] }
    withName: BLOCKS    { publishDir = [path: "${params.outdir}", mode: 'copy', saveAs: { it - ~/^out\// }] }
}
